  "info": {
    "_postman_id": "46d6ded8-07d4-4174-9f65-b8f785d0c5cb",
    "name": "Cisco Secure Firewall Management Center API (Secure Client management plane) AccessPolicies Authentication API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Cisco Secure Firewall Management Center (FMC) REST API configures\nremote-access VPN gateways, group policies, devices, and Secure Client\nprofiles distributed to endpoints. Authentication uses a token generated\nvia the generatetoken endpoint and passed as the X-auth-access-token\nheader on subsequent calls; the response also returns an\nX-auth-refresh-token used to refresh.\n\n\nContact Support:\n Name: Cisco DevNet",
      "type": "text/plain"
    }
  }
